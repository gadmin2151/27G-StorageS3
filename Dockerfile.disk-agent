FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends cifs-utils nfs-common util-linux && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json ./
COPY src ./src
ENV HOST=0.0.0.0 DISK_PORT=9200 DISK_STATE_DIR=/var/lib/storeges3-disks
EXPOSE 9200
CMD ["node", "src/disk-agent.mjs"]
