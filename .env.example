# Optional HTTPS deployment; leave unset for local use.
# DOMAIN=s3.example.com
# PUBLIC_ORIGIN=https://s3.example.com
CACHE_BYTES=67108864
UPLOAD_CONCURRENCY=4
QUEUE_LIMIT=32
MAX_OBJECT_BYTES=5368709120

# Optional first-start initialization with compose.yaml + compose.init.yaml.
# Does not change an existing installation. See docs/INITIALIZATION.md (EN)
# or docs/INITIALIZATION.ru.md (RU). Leave passwords/secrets out of this file.
# INIT_ENABLED=true
# INIT_ADMIN_USERNAME=admin
# INIT_BUCKET=app-data
# INIT_BUCKET_ACCESS=private
# INIT_BUCKET_QUOTA_BYTES=10737418240
# INIT_BUCKET_QUOTA_OBJECTS=10000
# Public-read example (anonymous bucket listing remains forbidden):
# INIT_BUCKET_ACCESS=public-read
# INIT_BUCKET_READ_PREFIXES='["images/"]'
# For multiple users/buckets/keys, use JSON instead of the simple INIT_* fields:
# INIT_CONFIG_FILE=/run/secrets/init.json
# Mount host files into /run/secrets using the documented Compose override.
# The container runs as UID/GID 1000:1000 and must be able to read these files.
# INIT_ADMIN_PASSWORD_FILE=/run/secrets/admin-password
# INIT_S3_SECRET_KEY_FILE=/run/secrets/s3-secret
